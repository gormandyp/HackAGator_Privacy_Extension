{
  "manifest_version": 3,
  "name": "PrivaC",
  "version": "0.1.0",
  "description": "See which companies watch your browsing, get a privacy grade for every site, and let C decline the extra cookies.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "PrivaC",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "permissions": [
    "storage",
    "activeTab",
    "webRequest",
    "webNavigation",
    "alarms",
    "cookies"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "shared/mascot.js",
        "content/regtrack-line.js",
        "content/c-prompt.js",
        "content/c-events.js",
        "content/cookie-detector.js",
        "content/alerts.js",
        "content/policy-link.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "shared/regtrack-facts.json"
      ],
      "matches": [
        "<all_urls>"
      ]
    },
    {
      "resources": [
        "c-poses/*.svg"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
}
