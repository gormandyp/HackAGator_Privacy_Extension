{
  "manifest_version": 3,
  "name": "PrivaC",
  "version": "0.1.0",
  "description": "See which companies track you on each site, get an A-F privacy grade, and let C decline extra cookies. Its AI runs on your computer.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "PrivaC",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "permissions": [
    "storage",
    "webRequest",
    "webNavigation",
    "alarms",
    "cookies",
    "scripting",
    "offscreen",
    "unlimitedStorage"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "shared/mascot.js",
        "content/regtrack-line.js",
        "content/c-prompt.js",
        "content/c-events.js",
        "content/c-alert-look.js",
        "content/c-reaction-look.js",
        "content/c-placement.js",
        "content/cookie-detector.js",
        "content/alerts.js",
        "content/policy-link.js",
        "content/panel.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/cookie-detector.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "shared/regtrack-facts.json"
      ],
      "matches": [
        "<all_urls>"
      ]
    },
    {
      "resources": [
        "c-poses/*.svg"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    },
    {
      "resources": [
        "popup/popup.html"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "use_dynamic_url": true
    }
  ]
}
